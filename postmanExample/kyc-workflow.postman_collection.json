	"item": [
		{
			"name": "Create Application",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse the JSON response",
							"const jsonData = pm.response.json();",
							"",
							"// Extract the id field and save it to an environment variable",
							"const kycApplicationId = jsonData.id;",
							"pm.environment.set(\"kycApplicationId\", kycApplicationId);",
							"",
							"// Test that the id field exists and is a non-empty string",
							"pm.test(\"id field exists and is a non-empty string\", function () {",
							"    pm.expect(kycApplicationId).to.exist;",
							"    pm.expect(kycApplicationId).to.be.a(\"string\");",
							"    pm.expect(kycApplicationId).to.not.be.empty;",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
